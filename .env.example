APP_NAME="FlowerShop"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Thông tin Cửa hàng gốc (Nơi cắm hoa và xuất phát đơn ship)
SHOP_NAME="Flower Shop Sài Gòn"
SHOP_PHONE="0901234567"
SHOP_ADDRESS="123 Nguyễn Huệ, Phường Bến Nghé, Quận 1, TP. Hồ Chí Minh"
SHOP_PROVINCE_ID=202          # TP. Hồ Chí Minh
SHOP_DISTRICT_ID=1442         # Quận 1
SHOP_WARD_CODE="20101"        # Phường Bến Nghé
SHOP_OPEN_TIME="07:30"        # Giờ mở cửa tiệm
SHOP_CLOSE_TIME="21:00"       # Giờ đóng cửa tiệm
MAX_ORDERS_PER_SLOT=15        # Giới hạn đơn tối đa / khung giờ 2 tiếng

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=shop_flower
DB_USERNAME=postgres
DB_PASSWORD=secret

# Giao Hàng Nhanh (GHN Express) API
GHN_SHOP_ID=your_ghn_shop_id
GHN_TOKEN=your_ghn_api_token
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api

# SMTP PHPMailer Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_ADDRESS=noreply@flowershop.vn
MAIL_FROM_NAME="Flower Shop Online"
